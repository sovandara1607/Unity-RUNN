# Copy to .env and adjust for local development.
# NEVER commit a real .env file.

# --- Application ---
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
# Used by the Go API (DATABASE_URL) and docker-compose (POSTGRES_*).
POSTGRES_USER=unity
POSTGRES_PASSWORD=unity
POSTGRES_DB=unity_run_club
POSTGRES_PORT=5432
DATABASE_URL=postgres://unity:unity@localhost:5432/unity_run_club?sslmode=disable
DATABASE_MAX_CONN=10

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudflare R2 (future phase) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Google SMTP (future phase) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
