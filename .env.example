# Copy to .env and adjust for local development.
# NEVER commit a real .env file.

# --- Application ---
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
# Used by the Go API (DATABASE_URL) and docker-compose (POSTGRES_*).
POSTGRES_USER=unity
POSTGRES_PASSWORD=unity
POSTGRES_DB=unity_run_club
POSTGRES_PORT=5432
DATABASE_URL=postgres://unity:unity@localhost:5432/unity_run_club?sslmode=disable
DATABASE_MAX_CONN=10

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Realtime (Socket.IO) ---
# Browser-facing Socket.IO gateway. Keep Redis private; the Go API publishes
# trusted changes internally and this gateway only broadcasts them outward.
REALTIME_PORT=8081
NEXT_PUBLIC_REALTIME_URL=http://localhost:8081
REALTIME_INTERNAL_URL=http://localhost:8081

# --- Image and file storage ---
# Use local for development. Set to r2 in production after filling every R2
# variable below. R2 credentials are server-only and must never use NEXT_PUBLIC_.
OBJECT_STORAGE_PROVIDER=local
# Local fallback; Docker Compose persists this directory in a volume.
UPLOAD_DIR=uploads

# Cloudflare R2 S3 API. The endpoint below is this project's account endpoint
# and bucket; the backend also accepts the endpoint without /unity-runn-club.
R2_ENDPOINT=https://5c9a0fa93f233126f351e90ba5c88e74.r2.cloudflarestorage.com/unity-runn-club
R2_BUCKET=unity-runn-club
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public custom domain connected to this bucket, e.g.
# https://assets.example.com. When empty, the API securely streams public
# assets from the private bucket through /api/v1/media. Do not use the private
# cloudflarestorage.com S3 API endpoint as an image URL.
R2_PUBLIC_BASE_URL=

# --- Auth (JWT + RBAC) ---
# Signs/verifies access tokens (HS256). Required in every environment; generate
# one with `openssl rand -hex 48`. Never reuse it across deployments.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# --- Google SMTP ---
# All optional: leave unset for local dev and emails are logged, not
# sent (see internal/email.NoopSender). Required in production.
# SMTP_USER is a Gmail address; SMTP_PASSWORD must be an App Password
# (https://myaccount.google.com/apppasswords), never the real account
# password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Google sign-in (OAuth 2.0 web application) ---
# Create a Web application client in Google Cloud Console. The redirect URI
# must match exactly, including scheme, host, port, and path.
PUBLIC_APP_URL=http://localhost:3000
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- Notifications (async email pipeline) ---
REMINDER_WINDOW=24h
REMINDER_POLL_INTERVAL=15m
NOTIFICATION_SWEEP_INTERVAL=30s
NOTIFICATION_MAX_ATTEMPTS=5
# Paid registration provider. Use mock only for local development.
PAYMENT_PROVIDER=mock

# Bakong KHQR / Open API (required when PAYMENT_PROVIDER=bakong)
BAKONG_BASE_URL=
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_MERCHANT_NAME=UNITY RUNN CLUB
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_MCC=5999
BAKONG_STORE_LABEL=UNITY RUNN CLUB
BAKONG_TERMINAL_LABEL=WEB
BAKONG_PAYMENT_TTL=10m
