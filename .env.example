# Copy to .env and adjust for local development.
# NEVER commit a real .env file.

# --- Application ---
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
# Used by the Go API (DATABASE_URL) and docker-compose (POSTGRES_*).
POSTGRES_USER=unity
POSTGRES_PASSWORD=unity
POSTGRES_DB=unity_run_club
POSTGRES_PORT=5432
DATABASE_URL=postgres://unity:unity@localhost:5432/unity_run_club?sslmode=disable
DATABASE_MAX_CONN=10

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (JWT + RBAC) ---
# Signs/verifies access tokens (HS256). Generate a real random value
# (e.g. `openssl rand -base64 48`) for anything beyond local dev.
JWT_SECRET=dev-jwt-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# --- Cloudflare R2 (future phase) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Google SMTP ---
# All optional: leave unset for local dev and emails are logged, not
# sent (see internal/email.NoopSender). Required in production.
# SMTP_USER is a Gmail address; SMTP_PASSWORD must be an App Password
# (https://myaccount.google.com/apppasswords), never the real account
# password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Notifications (async email pipeline) ---
REMINDER_WINDOW=24h
REMINDER_POLL_INTERVAL=15m
NOTIFICATION_SWEEP_INTERVAL=30s
NOTIFICATION_MAX_ATTEMPTS=5
