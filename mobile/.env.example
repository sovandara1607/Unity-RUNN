# Public origins only. Never copy backend .env values into this file.
# iOS simulator: localhost; Android emulator: 10.0.2.2; physical phone: your Mac LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Google sign-in needs no mobile-specific config: it reuses the web app's own Google OAuth
# client via the same /api/v1/auth/google flow (see backend/internal/auth/google_oauth.go).
