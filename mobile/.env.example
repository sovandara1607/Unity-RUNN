# Public origins only. Never copy backend .env values into this file.
# iOS simulator: localhost; Android emulator: 10.0.2.2; physical phone: your Mac LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional. Socket.IO push updates for events/registrations (see services/realtime/).
# Omit it and the app falls back to its existing pull-based refresh (pull-to-refresh,
# and a refetch when the app returns to the foreground). Matches the frontend's
# NEXT_PUBLIC_REALTIME_URL -- if your local setup remaps the realtime service off its
# compose default (8081 collides with Metro's own default port), use that port here too.
EXPO_PUBLIC_REALTIME_URL=http://localhost:8081

# Google sign-in needs no mobile-side config: GoogleSignInButton opens the backend's existing
# browser-based OAuth flow (backend/internal/auth/google_oauth.go), same as the web app.
