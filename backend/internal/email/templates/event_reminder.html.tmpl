{{define "emailTitle"}}Race day is coming{{end}}
{{define "preheader"}}Your race-day briefing for {{.EventName}}.{{end}}
{{define "emailContent"}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr><td style="padding:38px 34px 18px;color:#3155ff;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;">Race brief / {{.RegistrationNumber}}</td></tr>
  <tr><td style="padding:0 34px 22px;color:#111;font-size:42px;line-height:1.02;font-weight:900;letter-spacing:-1.8px;text-transform:uppercase;">Next stop: start line.</td></tr>
  <tr><td style="padding:0 34px 28px;color:#5c5c58;font-size:16px;line-height:1.65;">Hi {{.FullName}}, <strong style="color:#111;">{{.EventName}}</strong> is coming up. Charge your phone, open your race wallet, and have the ticket ready at check-in.</td></tr>
  <tr><td style="padding:0 34px 34px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#d9ff00;border:2px solid #111;">
    <tr><td style="padding:20px 22px;color:#364000;font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;">When</td><td align="right" style="padding:20px 22px;color:#111;font-size:14px;font-weight:900;">{{.EventDate}} / {{.StartTime}}</td></tr>
    <tr><td style="padding:0 22px 20px;color:#364000;font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;">Where</td><td align="right" style="padding:0 22px 20px;color:#111;font-size:14px;font-weight:900;">{{.Location}}</td></tr>
  </table></td></tr>
  <tr><td style="padding:0 34px 38px;"><a href="{{.DashboardURL}}" style="display:inline-block;background:#111;color:#fff;text-decoration:none;padding:15px 21px;font-size:12px;font-weight:900;letter-spacing:1.2px;text-transform:uppercase;">Open ticket →</a></td></tr>
</table>{{end}}
